{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "rootDir": "./src",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "typeRoots": ["./types", "./src/types", "./node_modules/@types"],
    "types": ["node", "express"],
    "resolveJsonModule": true,
    "sourceMap": true
  },
  "include": ["src/**/*", "src/types/**/*.d.ts", "types/**/*.d.ts"],
  "exclude": ["dist"]
}
